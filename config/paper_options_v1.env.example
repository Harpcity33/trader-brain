# Trader Brain Paper Options v1 — local secrets only
# Copy to ~/.config/trader-brain/paper-options.env on the private Mac/server.
# NEVER commit the populated file.

MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=https://api.massive.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high

# Gmail notifications. Prefer a Google App Password on the private host.
TB_GMAIL_SENDER=
TB_GMAIL_APP_PASSWORD=
TB_GMAIL_RECIPIENT=

# Runtime
TB_REPO_PATH=
TB_LOG_DIR=
