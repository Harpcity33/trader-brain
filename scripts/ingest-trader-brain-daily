#!/bin/zsh
set -euo pipefail

PROJECT_ROOT="${0:A:h:h}"
BUNDLED_PYTHON="/Users/harp/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3"

if [[ -n "${TITAN_PYTHON:-}" && -x "${TITAN_PYTHON}" ]]; then
  PYTHON_BIN="${TITAN_PYTHON}"
elif [[ -x "${BUNDLED_PYTHON}" ]]; then
  PYTHON_BIN="${BUNDLED_PYTHON}"
else
  PYTHON_BIN="$(command -v python3)"
fi

export PYTHONPATH="${PROJECT_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON_BIN}" -m titan_runtime.daily_ingest \
  --config "${PROJECT_ROOT}/config/titan-massive.json" "$@"
